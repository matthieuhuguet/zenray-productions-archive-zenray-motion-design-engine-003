STOPS_GL = """float w[5] = float[5](wa.x, wa.y, wa.z, wb.x, wb.y);
  float tot = w[0] + w[1] + w[2] + w[3] + w[4];
  vec3 c[6] = vec3[6](c0, c1, c2, c3, c4, c5);
  float x = clamp(t, 0.0, 1.0) * tot;
  vec3 col = c5;
  float acc = 0.0;
  for (int i = 0; i < 5; i++) {
    float e = acc + w[i];
    if (x <= e) { col = mix(c[i], c[i + 1], clamp((x - acc) / max(w[i], 1e-6), 0.0, 1.0)); break; }
    acc = e;
  }"""
STOPS_PY = """w = [q['wa'][0], q['wa'][1], q['wa'][2], q['wb'][0], q['wb'][1]]
    tot = sum(w)
    c = [_v(q['c%d' % i]) for i in range(6)]
    x = np.clip(t, 0.0, 1.0) * tot
    col = np.ones(x.shape + (3,)) * c[5]
    done = np.zeros(x.shape, bool)
    acc = 0.0
    for i in range(5):
        e = acc + w[i]
        sel = (~done) & (x <= e)
        f = np.clip((x - acc) / max(w[i], 1e-6), 0.0, 1.0)[..., None]
        col = np.where(sel[..., None], c[i] + (c[i + 1] - c[i]) * f, col)
