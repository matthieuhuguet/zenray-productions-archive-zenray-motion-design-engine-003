  "tags": [
    "effect",
    "filter",
    "highpass",
    "sweep",
    "build"
  ],
  "sources": [
    {
      "what": "biquad magnitude responses",
      "url": "https://www.w3.org/TR/audio-eq-cookbook/",
      "reference": "R. Bristow-Johnson, Audio EQ Cookbook (formulas placed in the public domain by the author)",
      "licence": "public domain (formulas), code original"
    }
  ],
  "licence": "original",
  "params": [
    {
      "name": "start_hz",
      "unit": "Hz",
      "min": 20.0,
      "max": 16000.0,
      "default": 80.0,
      "scale": "log",
      "description": "cutoff at the start of the window"
    },
    {
      "name": "end_hz",
      "unit": "Hz",
      "min": 20.0,
      "max": 16000.0,
      "default": 2000.0,
      "scale": "log",
