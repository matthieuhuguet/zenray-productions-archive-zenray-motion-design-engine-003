    {
      "name": "q",
      "unit": "Q",
      "min": 0.5,
      "max": 12.0,
      "default": 1.0,
      "scale": "log",
      "description": "resonance"
    },
    {
      "name": "out_db",
      "unit": "dB",
      "min": -24.0,
      "max": 12.0,
      "default": 0.0,
      "scale": "lin",
      "description": "output gain"
    }
  ],
  "date": "12 October 2026"
