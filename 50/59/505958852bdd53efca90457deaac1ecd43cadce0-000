#!/usr/bin/env python3
# 12 October 2026 (A4): per-event before/after table of SFX versions under BOTH scores.
# For every SFX event of each version, the shipped sound (a B1 recipe or a bank chain) is rendered inside its event
# window exactly as ReproduceSound places it, and scored against the reference window cut from the stem the event was
# detected on: ploss (spectrogram 1:1, zrmd/audio/ploss.py) and B1 (describe.compare, the V_017 metric). Analysis only:
# the reference windows are read from the refcache and never written anywhere.
# Usage: python -I Scripts/SfxEventTable.py --slug onekey-pro-2 --versions V_017,V_019 [--json out.json] [--markdown]
# --check proves the table both ways: a version's chain scored against its own render must give ploss 100 (green),
# and the same chain scored against another event's window must stay under 90 (red); exit 0 when both behave.
# FR : tableau avant/après par événement, sous les deux scores ; preuve dans les deux sens avec --check.
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

os.environ.setdefault("OMP_NUM_THREADS", "1")
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import numpy as np  # noqa: E402

from zrmd import settings  # noqa: E402
from zrmd.audio import bank, config, fit  # noqa: E402
from zrmd.media import load_audio  # noqa: E402

W = Path("/Users/zenray/.claude/tmp/tmp-zenray-motion-design/sound")


def stems(slug: str, sr: int) -> dict:
    d = settings.path("refcache") / slug / "stems" / "out" / "htdemucs" / "mix"
    return {k: load_audio(d / f"{k}.wav", sr, mono=True)[0].astype(np.float64) for k in ("drums", "bass", "other", "vocals") if (d / f"{k}.wav").exists()}


def window(st: dict, e: dict, sr: int) -> np.ndarray:
    y = sum(st[k] for k in e["stem"].split("+"))
    return y[int(e["windowStart"] * sr):int(e["windowEnd"] * sr)]


def shipped_window(f: dict, n: int, sr: int) -> np.ndarray:
    if f.get("chain"):
        ch = dict(f["chain"], seconds=n / sr)
        return bank.render_chain(ch).astype(np.float64)[:n]
    return fit._recipe_window(f, n, sr)


def table(slug: str, names: list[str]) -> list[dict]:
    sr = config.get("audio.sampleRate")
    st = stems(slug, sr)
    rows = []
    for v in names:
        ev = json.loads((W / slug / v / "events.json").read_text())["events"]
        for e in ev:
            f = e.get("fit")
            if not f:
                continue
            x = window(st, e, sr)
            s = fit.score_window(shipped_window(f, len(x), sr), x, sr)
            rows.append({"version": v, "id": e["id"], "t": e["t"], "stem": e["stem"], "shipped": "+".join(f.get("chainIds", [])) or f["kind"],
                         "eventScore": f.get("score"), "ploss": s["ploss"], "plossStochastic": s["plossStochastic"], "b1": s["b1"], "errors": s["errors"]})
    return rows


def check(slug: str, version: str) -> int:
    sr = config.get("audio.sampleRate")
    st = stems(slug, sr)
    ev = [e for e in json.loads((W / slug / version / "events.json").read_text())["events"] if (e.get("fit") or {}).get("chain")]
    if len(ev) < 2:
        print("check needs a version with at least two chain events")
        return 1
    a, b = ev[0], ev[1]
    xa = window(st, a, sr)
    own = shipped_window(a["fit"], len(xa), sr)
    green = fit.score_window(own, own, sr)["ploss"]
    xb = window(st, b, sr)
    red = fit.score_window(shipped_window(a["fit"], len(xb), sr), xb, sr)["ploss"]
    ok = green >= 99.999 and red <= 90.0
    print(json.dumps({"green": green, "red": red, "pass": ok}))
    return 0 if ok else 1


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--slug", default="onekey-pro-2")
    ap.add_argument("--versions", default="V_017")
    ap.add_argument("--json")
    ap.add_argument("--markdown", action="store_true")
    ap.add_argument("--check")
    a = ap.parse_args()
    if a.check:
        return check(a.slug, a.check)
    rows = table(a.slug, a.versions.split(","))
    if a.json:
        Path(a.json).write_text(json.dumps(rows, indent=1) + "\n")
    if a.markdown:
        # 12 October 2026 (A4): stochastic column added (seed-invariant ploss of A3).
        print("| Version | Event | Shipped | Event score | ploss official | ploss stochastic | B1 |\n|---|---|---|---|---|---|---|")
        for r in rows:
            print(f"| {r['version']} | {r['id']} | {r['shipped']} | {r['eventScore']} | {r['ploss']} | {r['plossStochastic']} | {r['b1']} |")
    else:
        print(json.dumps(rows, indent=1))
    return 0


if __name__ == "__main__":
    sys.exit(main())
