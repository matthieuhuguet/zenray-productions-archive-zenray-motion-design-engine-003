# 12 October 2026: highpass_sweep, an RBJ highpass whose cutoff glides exponentially from start_hz to end_hz with time
# constant sweep_s (from the start of the window), applied as its magnitude response on the STFT grid, one cutoff per
# frame (zero phase: the magnitude matches the biquad, the phase does not). Effect block: alone it processes the fixed
# test exciter of zrmd/audio/fxdsp.py, in a chain it processes the bus. FR : filtre highpass à coupure glissante.
import math

import torch

from zrmd.audio.bank import db_to_amp, stft_filter
from zrmd.audio import fxdsp as F
from zrmd.audio.fxdsp import EffectBlock
from zrmd.audio.fxdsp import param as P

META = {"family": "filter", "kind": "effect",
        "description": "Resonant highpass whose cutoff glides from a start to an end frequency. Thinning builds, telephone moves, risers. (12 October 2026)",
        "tags": ['effect', 'filter', 'highpass', 'sweep', 'build'],
        "sources": [F.RBJ],
        "licence": "original"}


class HighpassSweep(EffectBlock):
    ID = "highpass_sweep"
    # 12 October 2026 (A2): fit hints measured on the failed cases of the first A2 verification (docs/build/
    # A2-tonal-effects.md): a larger search budget, and coupled groups for the evolution strategy. FR : indications.
    FIT = {"scanRounds": 6, "polishRounds": 12, "starts": 12, "screenSamples": 1024}
    PARAMS = [
        P("start_hz", "Hz", 20, 16000, 80, "log", "cutoff at the start of the window"),
        P("end_hz", "Hz", 20, 16000, 2000, "log", "cutoff reached"),
        P("sweep_s", "s", 0.02, 1.0, 0.3, "log", "glide time constant"),
        P("q", "Q", 0.5, 12.0, 1.0, "log", "resonance"),
        P("out_db", "dB", -24, 12, 0, "lin", "output gain"),
    ]

    def fx(self, v, x, t, sr):
        def mask(fr, tm):
            fc = v["end_hz"] * torch.pow(v["start_hz"] / v["end_hz"], torch.exp(-tm / v["sweep_s"]))
            return F.biquad_mag("highpass", fr, fc, v["q"], sr=sr)

        return db_to_amp(v["out_db"]) * stft_filter(x, mask, 1024, 256, sr)


BLOCK = HighpassSweep
