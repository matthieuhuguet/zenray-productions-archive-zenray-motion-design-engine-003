# 12 October 2026: verifier of the B2 deliverables (bible.json, bible.md, storyboard.html, INDEX.md) of every reference.
# Checks: shot count equals non-flash cuts plus one; every shot has an eye description (no automatic sentence left);
# no em dash or en dash in bible.md, storyboard.html, INDEX.md; every storyboard image points into the local reference
# cache by the relative path ../../../tmp-zenray-motion-design-refcache/<slug>/ and the file exists; no image or video
# file inside the workshop reference folder; optional page check at 375 px through Scripts/CheckPageWidth.mjs.
# Exit code 0 when everything holds, 1 otherwise; --json prints the report.
# Run: /Users/zenray/.venvs/zenray-motion/bin/python -I Scripts/CheckReferenceBooks.py [--root DIR] [--width] [--json]
# FR : verificateur des bibles et storyboards ; code de sortie 0 si tout tient.
from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
DEFAULT_ROOT = Path("/Users/zenray/.claude/tmp/tmp-zenray-motion-design/references")
DASHES = ("—", "–")
MEDIA = {".jpg", ".jpeg", ".png", ".webp", ".gif", ".mp4", ".mov", ".mkv", ".wav", ".mp3", ".m4a"}


def check_slug(folder: Path, width: bool) -> dict:
    slug = folder.name
    errors = []
    b = json.loads((folder / "bible.json").read_text(encoding="utf-8"))
    cuts = [c for c in b["cuts"] if c["kind"] != "flash"]
    if len(b["shots"]) != len(cuts) + 1:
        errors.append(f"{len(b['shots'])} shots for {len(cuts)} cuts")
    auto = [s["id"] for s in b["shots"] if not s.get("description")]
    if auto:
        errors.append(f"shots without eye description: {auto[:8]}")
    for name in ("bible.md", "storyboard.html"):
        text = (folder / name).read_text(encoding="utf-8")
        for d in DASHES:
            if d in text:
                errors.append(f"{name} contains a long dash ({text.count(d)})")
    html = (folder / "storyboard.html").read_text(encoding="utf-8")
    srcs = re.findall(r'<img[^>]+src="([^"]+)"', html)
    prefix = f"../../../tmp-zenray-motion-design-refcache/{slug}/"
    bad = [s for s in srcs if not s.startswith(prefix)]
    if bad:
        errors.append(f"image paths outside the cache: {bad[:3]}")
    missing = [s for s in srcs if s.startswith(prefix) and not (folder / s).resolve().exists()]
    if missing:
        errors.append(f"missing thumbnails: {missing[:3]}")
    media = [str(p) for p in folder.rglob("*") if p.suffix.lower() in MEDIA]
    if media:
        errors.append(f"media files inside the workshop: {media[:3]}")
    page = None
    if width:
        r = subprocess.run(["node", str(HERE / "CheckPageWidth.mjs"), str(folder / "storyboard.html"), "375"],
                           capture_output=True, text=True)
        try:
            page = json.loads(r.stdout.strip().splitlines()[-1])
        except Exception:
            page = {"error": r.stderr[-300:]}
        if r.returncode != 0:
            errors.append(f"page at 375 px: {page}")
    return {"slug": slug, "shots": len(b["shots"]), "cuts": len(cuts), "images": len(srcs), "ok": not errors,
            "errors": errors, "page_375": page and {k: page.get(k) for k in ("scrollWidth", "clientWidth", "brokenCount", "fonts")}}


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--root", default=str(DEFAULT_ROOT))
    ap.add_argument("--width", action="store_true")
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args()
    root = Path(a.root)
    rows = [check_slug(p.parent, a.width) for p in sorted(root.glob("*/bible.json"))]
    idx = root / "INDEX.md"
    index_errors = []
    if not idx.exists():
        index_errors.append("INDEX.md missing")
    else:
        t = idx.read_text(encoding="utf-8")
        index_errors += [f"INDEX.md contains a long dash" for d in DASHES if d in t]
        index_errors += [f"INDEX.md misses {r['slug']}" for r in rows if f"| {r['slug']} |" not in t]
    report = {"date": "12 October 2026", "references": len(rows), "ok": all(r["ok"] for r in rows) and not index_errors,
              "index_errors": index_errors, "rows": rows}
    if a.json:
        print(json.dumps(report, ensure_ascii=False, indent=1))
    else:
        for r in rows:
            print(("OK  " if r["ok"] else "FAIL"), r["slug"], r["shots"], r["images"], "; ".join(r["errors"]))
        print("INDEX", "OK" if not index_errors else index_errors)
    return 0 if report["ok"] else 1


if __name__ == "__main__":
    sys.exit(main())
