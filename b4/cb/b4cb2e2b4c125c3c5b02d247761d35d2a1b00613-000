#!/usr/bin/env python3
# 12 October 2026: task M2 diagnostic: where the third-octave band error (tfBands) of a version comes from, per stem:
# signed mean dB difference (ours - reference) by band group and by section, weighted like tfBands.
# Usage: DiagnoseResynth.py V_NNN [stems...]   FR : d'ou vient l'ecart par bandes, par groupe de bandes et par section.
import json
import math
import sys
from pathlib import Path

import numpy as np

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))
from zrmd.audio import resynth as RS  # noqa: E402


def main():
    v = sys.argv[1]
    stems = sys.argv[2:] or ["drums", "bass", "other", "mix"]
    P = RS.params()
    S = P["score"]["stable"]
    sr = P["sampleRate"]
    import librosa
    d = Path(P["paths"]["bench"]) / v
    ref = RS.load_reference(P)
    score = json.loads((d / "score.json").read_text())
    for k in stems:
        r = RS.mono(ref["mix"] if k == "mix" else ref["stems"][k])
        o = RS.mono(RS._read(d / ("mix.wav" if k == "mix" else f"stems/{k}.wav"), sr))[: len(r)]
        c = S["tfFMin"] * 2 ** (np.arange(0, int(3 * math.log2(S["tfFMax"] / S["tfFMin"])) + 1) / 3.0)
        W = RS._band_weights(np.fft.rfftfreq(S["tfNFft"], 1.0 / sr), c)
        pr = 10 * np.log10(W @ np.abs(librosa.stft(r, n_fft=S["tfNFft"], hop_length=S["tfHop"])) ** 2 + 1e-20)
        po = 10 * np.log10(W @ np.abs(librosa.stft(o, n_fft=S["tfNFft"], hop_length=S["tfHop"])) ** 2 + 1e-20)
        fl = pr.max() - S["tfFloorDb"]
        r2, o2 = np.maximum(pr, fl), np.maximum(po, fl)
        w = np.maximum(r2, o2) - fl
        diff = o2 - r2
        groups = [(30, 120), (120, 500), (500, 2000), (2000, 6000), (6000, 16000)]
        print(f"== {v} {k}: E total {float((w * np.abs(diff)).sum() / w.sum() / 2):.3f} JND")
        for a, b in groups:
            m = (c >= a) & (c < b)
            ww = w[m]
            print(f"  {a:>5}-{b:<5} Hz share {ww.sum() / w.sum():.2f} |d| {float((ww * np.abs(diff[m])).sum() / (ww.sum() + 1e-9)):.2f} dB signed {float((ww * diff[m]).sum() / (ww.sum() + 1e-9)):+.2f} dB")
        times = np.arange(pr.shape[1]) * S["tfHop"] / sr
        for sec in score["sections"]:
            f = (times >= sec["start"]) & (times < sec["end"])
            ww = w[:, f]
            print(f"  {sec['start']:6.2f}-{sec['end']:6.2f} s |d| {float((ww * np.abs(diff[:, f])).sum() / (ww.sum() + 1e-9)):.2f} dB signed {float((ww * diff[:, f]).sum() / (ww.sum() + 1e-9)):+.2f}")


if __name__ == "__main__":
    main()
