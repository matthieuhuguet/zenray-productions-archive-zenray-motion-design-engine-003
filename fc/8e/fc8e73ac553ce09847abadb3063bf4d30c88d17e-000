# 12 October 2026, 14:45 CEST: generator of the shader bank block arch_stack_grid (GLSL + numpy twin + block.json).
# Why: the reference light contours are each a power arch of their own, flatter outward (measured on onekey frame 48:
# k 0.49 inner to 0.07 outer, each contour fitted to 0.5 to 3.7 px), which a normal-distance ramp cannot produce.
# Model: three control arches at levels s = 0 (inner, the dark arch edge), 0.5, 1 (outer); apex, k, p interpolated
# piecewise linearly in s and extrapolated beyond [0, 1]; each pixel finds its level s by bisection (the arches are
# nested: v_s(x) decreases with s). Colour: ND x NV grid over (s in [S0, S1], height v), smoothstep bilinear, linear
# in the image, so a fit solves the grid colours exactly. ND, NV, S0, S1, iterations are the generator constants.
import json
from pathlib import Path

ND, NV, S0, S1, ITER = 14, 8, -0.15, 2.4, 20  # 12 October 2026, 16:55: S1 2.4 (corner staircase), 14 knots. Earlier: 12 October 2026, 15:15: 12 x 8 (white to amber to dark along a contour needs more rows)
GAMMA = 2.2  # 12 October 2026, 15:40: knots denser near the inner arch (thin blue rim), fi = (ND-1) * ((s-S0)/(S1-S0))^(1/GAMMA)
BANK = Path(__file__).resolve().parents[1] / "datasets" / "shaders" / "arch_stack_grid"
BANK.mkdir(parents=True, exist_ok=True)
names = [f"c_{i}_{j}" for j in range(NV) for i in range(ND)]
geo = [("cx", 0.5, 0.3, 0.7)] + [(f"{n}{l}", d, lo, hi) for l, ds in enumerate(((0.55, 0.49, 1.44), (0.49, 0.25, 1.6), (0.43, 0.08, 1.7)))
                                   for n, d, lo, hi in zip(("apex", "k", "p"), ds, (0.0, 0.0, 0.4), (1.2, 3.0, 5.0))]
params = [{"name": n, "type": "float", "default": d, "min": lo, "max": hi, "unit": "canvas"} for n, d, lo, hi in geo]
params += [{"name": n, "type": "color", "default": [0.5, 0.5, 0.5], "min": [0, 0, 0], "max": [1, 1, 1], "unit": "srgb"} for n in names]
meta = {"id": "arch_stack_grid", "family": "A",
        "description": f"Stack of nested power arches (inner, middle, outer control arches, parameters interpolated), level found by bisection, {ND} x {NV} colour grid over (level, height). Colour block. (12 October 2026)",
        "params": params, "source_url": "original", "licence": "original (written from the mathematics), same licence as the engine",
        "attribution": "ZenRay Motion Design", "tags": ["arch", "contours", "gradient", "wallpaper", "fit"], "looks": ["arch-glow-wallpaper"]}
(BANK / "block.json").write_text(json.dumps(meta, indent=1) + "\n")
gargs = ", ".join(f"float {n}" for n, *_ in geo)
cargs = ", ".join(f"vec3 {n}" for n in names)
glsl = f"""// 12 October 2026: arch_stack_grid, generated by Scripts/MakeArchStackGrid.py (do not edit by hand). Licence: original.
vec3 asg_par(float s, float a0, float k0, float p0, float a1, float k1, float p1, float a2, float k2, float p2) {{
  vec3 q0 = vec3(a0, k0, p0), q1 = vec3(a1, k1, p1), q2 = vec3(a2, k2, p2);
  vec3 q = s < 0.5 ? mix(q0, q1, s * 2.0) : mix(q1, q2, (s - 0.5) * 2.0);
  return vec3(q.x, max(q.y, 0.0), max(q.z, 0.3));
}}
vec4 arch_stack_grid(vec2 uv, {gargs}, {cargs}) {{
  vec3 C[{ND * NV}] = vec3[]({", ".join(names)});
  float x = abs(2.0 * (uv.x - cx));
  float lo = {S0}, hi = {S1};
  for (int it = 0; it < {ITER}; it++) {{
    float m = 0.5 * (lo + hi);
    vec3 q = asg_par(m, apex0, k0, p0, apex1, k1, p1, apex2, k2, p2);
    float vs = q.x + q.y * pow(x, q.z);
    if (uv.y < vs) lo = m; else hi = m;
  }}
  float s = 0.5 * (lo + hi);
  float fi = pow(clamp((s - ({S0})) / ({S1} - ({S0})), 0.0, 1.0), {1.0 / GAMMA}) * {ND - 1}.0;
  float fj = clamp(uv.y, 0.0, 1.0) * {NV - 1}.0;
  int i0 = min(int(floor(fi)), {ND - 2}); int j0 = min(int(floor(fj)), {NV - 2});
  float a = smoothstep(0.0, 1.0, fi - float(i0)); float b = smoothstep(0.0, 1.0, fj - float(j0));
  vec3 c0 = mix(C[j0 * {ND} + i0], C[j0 * {ND} + i0 + 1], a);
  vec3 c1 = mix(C[(j0 + 1) * {ND} + i0], C[(j0 + 1) * {ND} + i0 + 1], a);
  return vec4(mix(c0, c1, b), 1.0);
}}
"""
(BANK / "block.glsl").write_text(glsl)
twin = f'''# 12 October 2026: numpy twin of arch_stack_grid, generated by Scripts/MakeArchStackGrid.py (do not edit by hand).
import numpy as np

ND, NV, S0, S1, ITER, GAMMA = {ND}, {NV}, {S0}, {S1}, {ITER}, {GAMMA}
NAMES = {names!r}


def _ss(x):
    x = np.clip(x, 0.0, 1.0)
    return x * x * (3.0 - 2.0 * x)


def _par(q, s):
    a = np.array([[q["apex0"], q["k0"], q["p0"]], [q["apex1"], q["k1"], q["p1"]], [q["apex2"], q["k2"], q["p2"]]], np.float32)
    s = s[..., None].astype(np.float32)
    lo = a[0] + (a[1] - a[0]) * (s * 2.0)
    hi = a[1] + (a[2] - a[1]) * ((s - 0.5) * 2.0)
    r = np.where(s < 0.5, lo, hi)
    return r[..., 0], np.maximum(r[..., 1], 0.0), np.maximum(r[..., 2], 0.3)


def level(q, u, v):
    # float32 like the GPU, so the bisection takes the same branches.
    x = np.abs(np.float32(2.0) * (u.astype(np.float32) - np.float32(q["cx"]))).astype(np.float32)
    v = v.astype(np.float32)
    lo = np.full(x.shape, S0, np.float32); hi = np.full(x.shape, S1, np.float32)
    for _ in range(ITER):
        m = np.float32(0.5) * (lo + hi)
        ap, k, p = _par(q, m)
        vs = ap + k * np.power(x, p)
        below = v < vs
        lo = np.where(below, m, lo); hi = np.where(below, hi, m)
    return (np.float32(0.5) * (lo + hi)).astype(float)


def basis(q, u, v):
    s = level(q, u, v)
    fi = np.power(np.clip((s - S0) / (S1 - S0), 0.0, 1.0), 1.0 / GAMMA) * (ND - 1)
    fj = np.clip(v, 0.0, 1.0) * (NV - 1)
    i0 = np.minimum(np.floor(fi).astype(int), ND - 2); j0 = np.minimum(np.floor(fj).astype(int), NV - 2)
    a = _ss(fi - i0); b = _ss(fj - j0)
    W = np.zeros(fi.shape + (ND * NV,))
    for di, wa in ((0, 1 - a), (1, a)):
        for dj, wb in ((0, 1 - b), (1, b)):
            idx = (j0 + dj) * ND + (i0 + di)
            np.put_along_axis(W, idx[..., None], np.take_along_axis(W, idx[..., None], -1) + (wa * wb)[..., None], -1)
    return W


def render(params, u, v):
    C = np.array([params[n] for n in NAMES], float)
    return basis(params, u, v) @ C * 255.0
'''
(BANK / "twin.py").write_text(twin)
print(BANK)
