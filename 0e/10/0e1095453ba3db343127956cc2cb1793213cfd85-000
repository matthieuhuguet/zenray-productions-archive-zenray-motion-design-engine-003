# 12 October 2026: saturation, a biased tanh waveshaper y = tanh(g (x + b)) - tanh(g b) (the bias adds even
# harmonics, the subtraction removes the DC step), wet/dry mix and output gain. FR : saturation tanh décentrée.
import math

import torch

from zrmd.audio.bank import db_to_amp, stft_filter
from zrmd.audio import fxdsp as F
from zrmd.audio.fxdsp import EffectBlock
from zrmd.audio.fxdsp import param as P

META = {"family": "distortion", "kind": "effect",
        "description": "Biased tanh waveshaper (drive, asymmetry, mix, output). Warmth, grit, overdrive, tape-like saturation. (12 October 2026)",
        "tags": ["effect", "saturation", "distortion", "drive", "warmth"],
        "sources": [{"what": "tanh waveshaping", "url": None, "licence": F.SOURCE}],
        "licence": "original"}


class Saturation(EffectBlock):
    ID = "saturation"
    PARAMS = [
        P("drive_db", "dB", 0, 36, 18, "lin", "input gain into the curve"),
        P("bias", "x", -0.5, 0.5, 0.1, "lin", "asymmetry (even harmonics)"),
        P("mix", "0..1", 0.0, 1.0, 1.0, "lin", "wet share"),
        P("out_db", "dB", -36, 6, -12, "lin", "output gain"),
    ]

    def fx(self, v, x, t, sr):
        g = db_to_amp(v["drive_db"])
        wet = torch.tanh(g * (x + v["bias"] * 0.2)) - torch.tanh(g * v["bias"] * 0.2)
        return db_to_amp(v["out_db"]) * (v["mix"] * wet + (1.0 - v["mix"]) * x)


BLOCK = Saturation
