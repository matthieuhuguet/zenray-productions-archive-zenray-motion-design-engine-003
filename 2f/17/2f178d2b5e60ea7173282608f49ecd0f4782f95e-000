# ---------------------------------------------------------------------------------------------------------------
def glsl_source(b):
    pre = b["id"] + "_"
    types = {"float": "float", "vec2": "vec2", "vec3": "vec3", "color": "vec3"}
    args = "".join(f", {types[p['type']]} {p['name']}" for p in b["params"])
    helpers = "\n".join(GLSL_HELPERS[h].replace("@", pre) for h in b["helpers"])
    plist = ", ".join(f"{p['name']} ({p['unit']})" for p in b["params"])
    head = (f"// {DATE}: {b['desc']}\n// {MARK}, written from the mathematics. uv: pixel centre in [0,1]^2, v downwards.\n"
            f"// Params: {plist}.\n")
    return head + (helpers + "\n" if helpers else "") + f"vec4 {b['id']}(vec2 uv{args}) {{\n  {b['glsl'].replace('@', pre)}\n}}\n"


def twin_source(b):
    kind = "HxW coverage 0..1 (mask block)" if b["family"] in ("mask",) or b["id"] == "ease_smootherstep_band" else "HxWx3 0..255 (colour block)"
    return (f"# {DATE}: numpy twin of block.glsl ({b['id']}), same formula vectorised. Returns {kind}.\n# {MARK}.\n"
            + PY_HELPERS + f"\n\ndef render(params, u, v):\n    q = params\n    {b['twin']}\n")


def block_json(b):
    return {"id": b["id"], "family": b["family"], "description": f"{b['desc']} ({DATE})", "params": b["params"],
            "source_url": b["source_url"], "licence": b["licence"], "attribution": f"ZenRay Motion Design, {DATE}",
            "tags": b["tags"], "looks": b["looks"]}


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--force", action="store_true", help="rewrite folders previously generated by this script")
    ap.add_argument("--only", default="")
    a = ap.parse_args()
    only = {s for s in a.only.split(",") if s}
    root = bank.root()
    written, skipped = [], []
    for b in BLOCKS:
        if only and b["id"] not in only:
            continue
        d = root / b["id"]
        if d.exists():
            glsl = d / "block.glsl"
            ours = glsl.exists() and MARK in glsl.read_text(encoding="utf-8")
            if not (a.force and ours):
                skipped.append(b["id"])
                continue
        d.mkdir(parents=True, exist_ok=True)
        (d / "block.glsl").write_text(glsl_source(b), encoding="utf-8")
        (d / "twin.py").write_text(twin_source(b), encoding="utf-8")
        (d / "block.json").write_text(json.dumps(block_json(b), indent=2) + "\n", encoding="utf-8")
        written.append(b["id"])
    # 12 October 2026: index rebuilt from the folders under the bank lock, so a concurrent writer is never lost.
    with open(root / ".index.lock", "w") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        bank.rebuild_index()
        fcntl.flock(lk, fcntl.LOCK_UN)
    print(json.dumps({"written": written, "skipped": skipped, "total_defined": len(BLOCKS)}, indent=1))
    return 0


if __name__ == "__main__":
    sys.exit(main())
