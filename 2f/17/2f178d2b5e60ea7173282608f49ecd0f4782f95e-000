       P("light_angle", "float", -90.0, -180.0, 180.0, "degrees (0 = right, -90 = up)"), GLOW_I, SOFT, ASPECT], ["cov", "box"],
      """vec2 p = (uv - center) * vec2(aspect, 1.0);
  float r = min(radius, min(half_size.x, half_size.y));
  vec2 q = abs(p) - half_size + r;
  vec2 g = max(q.x, q.y) > 0.0 ? normalize(max(q, 0.0) + 1e-9) : (q.x > q.y ? vec2(1.0, 0.0) : vec2(0.0, 1.0));
  g *= sign(p);
  float d = @box(p, half_size, radius);
  float a = radians(light_angle);
  float dirf = max(dot(g, vec2(cos(a), sin(a))), 0.0);
  float rim = exp(min(d, 0.0) / width) * dirf * @cov(d, soft) * intensity;
  return vec4(clamp(color * rim, 0.0, 1.0), 1.0);""",
      """px, py = _local(u, v, q["center"], q["aspect"])
    hx, hy = q["half_size"]
    r = min(q["radius"], min(hx, hy))
    qx, qy = np.abs(px) - hx + r, np.abs(py) - hy + r
    mx, my = np.maximum(qx, 0.0) + 1e-9, np.maximum(qy, 0.0) + 1e-9
    n = np.hypot(mx, my)
    outside = np.maximum(qx, qy) > 0.0
    gx = np.where(outside, mx / n, np.where(qx > qy, 1.0, 0.0)) * np.sign(px)
    gy = np.where(outside, my / n, np.where(qx > qy, 0.0, 1.0)) * np.sign(py)
    d = _box(px, py, q["half_size"], q["radius"])
    a = np.radians(q["light_angle"])
    dirf = np.maximum(gx * np.cos(a) + gy * np.sin(a), 0.0)
    rim = np.exp(np.minimum(d, 0.0) / q["width"]) * dirf * _cov(d, q["soft"]) * q["intensity"]
    return _colour(q["color"], rim)""",
      ["rim", "edge-light", "bevel", "card", "light", "colour"], ["device-edge", "card-rim", "glass-edge"])

block("metal_ring_tint", "light", "Flat metal ring shaded as a tube: Lambert with ambient plus Blinn specular with Schlick fresnel whose F0 is the metal tint (PBR-ish). Colour block.",
      [CENTER, P("radius", "float", 0.3, 0.1, 0.4, UVH), P("thickness", "float", 0.04, 0.01, 0.08, UVH),
       C("metal", [0.95, 0.75, 0.45]), P("light_angle", "float", -135.0, -180.0, 180.0, "degrees (azimuth)"),
       P("elevation", "float", 40.0, 10.0, 80.0, "degrees"), P("shininess", "float", 40.0, 4.0, 128.0, "Blinn exponent"),
       P("ambient", "float", 0.25, 0.0, 0.6, "level"), SOFT, ASPECT], ["cov"],
      """vec2 p = (uv - center) * vec2(aspect, 1.0);
  float l = length(p);
  vec2 dir = p / max(l, 1e-6);
  float s = clamp((l - radius) / thickness, -1.0, 1.0);
  vec3 n = vec3(dir * s, sqrt(max(1.0 - s * s, 0.0)));
  float az = radians(light_angle), el = radians(elevation);
  vec3 L = vec3(cos(az) * cos(el), sin(az) * cos(el), sin(el));
  vec3 H = normalize(L + vec3(0.0, 0.0, 1.0));
  float diff = max(dot(n, L), 0.0);
  float spec = pow(max(dot(n, H), 0.0), shininess);
  vec3 F = metal + (1.0 - metal) * pow(1.0 - max(H.z, 0.0), 5.0);
  vec3 col = metal * (ambient + (1.0 - ambient) * diff) + F * spec;
  return vec4(clamp(col, 0.0, 1.0) * @cov(abs(l - radius) - thickness, soft), 1.0);""",
      """px, py = _local(u, v, q["center"], q["aspect"])
    l = np.hypot(px, py)
    dx, dy = px / np.maximum(l, 1e-6), py / np.maximum(l, 1e-6)
    s = np.clip((l - q["radius"]) / q["thickness"], -1.0, 1.0)
    nx, ny, nz = dx * s, dy * s, np.sqrt(np.maximum(1.0 - s * s, 0.0))
    az, el = np.radians(q["light_angle"]), np.radians(q["elevation"])
    L = np.array([np.cos(az) * np.cos(el), np.sin(az) * np.cos(el), np.sin(el)])
    H = L + np.array([0.0, 0.0, 1.0])
    H = H / np.linalg.norm(H)
    diff = np.maximum(nx * L[0] + ny * L[1] + nz * L[2], 0.0)
    spec = np.maximum(nx * H[0] + ny * H[1] + nz * H[2], 0.0) ** q["shininess"]
    m = _v(q["metal"])
    F = m + (1.0 - m) * (1.0 - max(H[2], 0.0)) ** 5.0
    amb = q["ambient"]
    col = m * (amb + (1.0 - amb) * diff[..., None]) + F * spec[..., None]
    cov = _cov(np.abs(l - q["radius"]) - q["thickness"], q["soft"])[..., None]
    return np.clip(col, 0.0, 1.0) * cov * 255.0""",
      ["metal", "pbr", "ring", "bezel", "specular", "fresnel", "light", "colour"], ["metal-rim", "device-bezel", "watch-ring", "coin-edge"])

