block("ramp_oklab4", "gradient", "Four-stop linear ramp along an angle, interpolated in OKLab (perceptual, no grey dip between hues). Colour block.",
      [ANGLE, C("c0", [0.05, 0.05, 0.2]), C("c1", [0.2, 0.3, 0.9]), C("c2", [0.95, 0.4, 0.5]), C("c3", [1.0, 0.9, 0.55]),
       P("s1", "float", 0.35, 0.05, 0.5, "ramp position"), P("s2", "float", 0.7, 0.5, 0.95, "ramp position")],
      ["axis", "srgb", "oklab"],
      """float t = clamp(@axis(uv, angle), 0.0, 1.0);
  vec3 l0 = @lab(@to_lin(c0)), l1 = @lab(@to_lin(c1)), l2 = @lab(@to_lin(c2)), l3 = @lab(@to_lin(c3));
  float p1 = min(s1, s2), p2 = max(s1, s2);
  vec3 l;
  if (t < p1) l = mix(l0, l1, t / max(p1, 1e-6));
  else if (t < p2) l = mix(l1, l2, (t - p1) / max(p2 - p1, 1e-6));
  else l = mix(l2, l3, (t - p2) / max(1.0 - p2, 1e-6));
  return vec4(@to_srgb(@unlab(l)), 1.0);""",
      """t = np.clip(_axis(u, v, q["angle"]), 0.0, 1.0)[..., None]
    l0, l1, l2, l3 = (_lab(_to_lin(q[k])) for k in ("c0", "c1", "c2", "c3"))
