block("fresnel_rim_disc", "light", "Sphere seen as a disc: Schlick fresnel f0 + (1 - f0)(1 - n.z)^power mixes base and rim colours; black outside. Colour block.",
      [CENTER, P("radius", "float", 0.3, 0.1, 0.42, UVH), C("base", [0.08, 0.1, 0.25]), C("rim", [0.6, 0.85, 1.0]),
       P("f0", "float", 0.04, 0.0, 0.5, "reflectance at normal"), P("power", "float", 5.0, 1.0, 8.0, "exponent"), SOFT, ASPECT],
      ["cov"],
      """vec2 p = (uv - center) * vec2(aspect, 1.0);
  float l = length(p);
  float r = l / radius;
  float nz = sqrt(max(1.0 - r * r, 0.0));
  float f = f0 + (1.0 - f0) * pow(1.0 - nz, power);
  return vec4(mix(base, rim, f) * @cov(l - radius, soft), 1.0);""",
      """px, py = _local(u, v, q["center"], q["aspect"])
    l = np.hypot(px, py)
    r = l / q["radius"]
    nz = np.sqrt(np.maximum(1.0 - r * r, 0.0))
    f = (q["f0"] + (1.0 - q["f0"]) * (1.0 - nz) ** q["power"])[..., None]
    return _mix(_v(q["base"]), _v(q["rim"]), f) * _cov(l - q["radius"], q["soft"])[..., None] * 255.0""",
      ["fresnel", "rim", "sphere", "orb", "light", "colour"], ["orb", "sphere", "planet", "bubble"])

block("rim_light_rect", "light", "Directional rim light inside a rounded rectangle: exp(d / width) times max(dot(sdf gradient, light dir), 0), clipped by the shape. Colour block for add.",
