    seg1 = _mix(l1, l2, (t - p1) / max(p2 - p1, 1e-6))
    seg2 = _mix(l2, l3, (t - p2) / max(1.0 - p2, 1e-6))
    lab = np.where(t < p1, seg0, np.where(t < p2, seg1, seg2))
    return _to_srgb(_unlab(lab)) * 255.0""",
