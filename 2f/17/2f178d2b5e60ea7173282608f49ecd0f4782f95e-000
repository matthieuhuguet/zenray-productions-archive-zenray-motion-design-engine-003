# 12 October 2026: shared numpy helpers, one copy at the top of every twin (twins stay standalone files).
PY_HELPERS = '''import numpy as np


def _v(x):
    return np.asarray(x, dtype=float)


def _ss(e0, e1, x):
    t = np.clip((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)


def _cov(d, soft):
    return 1.0 - _ss(-soft, soft, d)


def _box(px, py, b, r):
    r = min(r, min(b[0], b[1]))
    qx = np.abs(px) - b[0] + r
    qy = np.abs(py) - b[1] + r
    return np.hypot(np.maximum(qx, 0.0), np.maximum(qy, 0.0)) + np.minimum(np.maximum(qx, qy), 0.0) - r


def _axis(u, v, angle):
    a = np.radians(angle)
    dx, dy = np.cos(a), np.sin(a)
    return 0.5 + ((u - 0.5) * dx + (v - 0.5) * dy) / (abs(dx) + abs(dy))


def _local(u, v, center, aspect):
    return (u - center[0]) * aspect, v - center[1]


def _smin(a, b, k):
    h = np.clip(0.5 + 0.5 * (b - a) / k, 0.0, 1.0)
    return b * (1.0 - h) + a * h - k * h * (1.0 - h)


def _mix(a, b, t):
    return a * (1.0 - t) + b * t


def _to_lin(c):
    c = _v(c)
    return np.where(c <= 0.04045, c / 12.92, ((np.maximum(c, 0.04045) + 0.055) / 1.055) ** 2.4)


def _to_srgb(c):
    c = np.clip(c, 0.0, 1.0)
    return np.where(c <= 0.0031308, c * 12.92, 1.055 * np.maximum(c, 0.0031308) ** (1.0 / 2.4) - 0.055)


def _lab(c):
    c = _v(c)
    r, g, b = c[..., 0], c[..., 1], c[..., 2]
    l = np.cbrt(np.maximum(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b, 0.0))
    m = np.cbrt(np.maximum(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b, 0.0))
    s = np.cbrt(np.maximum(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b, 0.0))
    return np.stack([0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
                     1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
                     0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s], axis=-1)


def _unlab(c):
    L, a, b = c[..., 0], c[..., 1], c[..., 2]
    l = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3
    m = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3
    s = (L - 0.0894841775 * a - 1.2914855480 * b) ** 3
    return np.stack([4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
                     -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
                     -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s], axis=-1)


def _ramp3(t, c0, c1, c2, s1):
    p = min(max(s1, 1e-4), 1.0 - 1e-4)
    t = t[..., None]
    return np.where(t < p, _mix(_v(c0), _v(c1), t / p), _mix(_v(c1), _v(c2), (t - p) / (1.0 - p)))


def _colour(col, g):
    return np.clip(_v(col) * g[..., None], 0.0, 1.0) * 255.0
'''


