block("ease_smootherstep_band", "curve", "Band along an angle between two edges with smootherstep (6t^5 - 15t^4 + 10t^3) feathers. Mask block.",
      [ANGLE, P("edge0", "float", 0.3, 0.05, 0.5, "ramp position"), P("edge1", "float", 0.7, 0.5, 0.95, "ramp position"),
       P("feather", "float", 0.08, 0.005, 0.2, "ramp units")], ["axis"],
      """float t = @axis(uv, angle);
  float e0 = min(edge0, edge1), e1 = max(edge0, edge1);
  float x0 = clamp((t - e0 + feather) / (2.0 * feather), 0.0, 1.0);
  float x1 = clamp((t - e1 + feather) / (2.0 * feather), 0.0, 1.0);
  float s0 = x0 * x0 * x0 * (x0 * (x0 * 6.0 - 15.0) + 10.0);
  float s1 = x1 * x1 * x1 * (x1 * (x1 * 6.0 - 15.0) + 10.0);
  return vec4(1.0, 1.0, 1.0, s0 * (1.0 - s1));""",
      """t = _axis(u, v, q["angle"])
    e0, e1, f = min(q["edge0"], q["edge1"]), max(q["edge0"], q["edge1"]), q["feather"]

    def sm(x):
        x = np.clip(x, 0.0, 1.0)
        return x * x * x * (x * (x * 6.0 - 15.0) + 10.0)
