# 12 October 2026: riser, a noise band and a sine both sweeping geometrically up from start_hz to end_hz while the
# level grows as progress ** curve, cut at the end with a 3 ms release. Derived from the mathematics. FR : montée.
import torch

from zrmd.audio import sfxdsp as D
from zrmd.audio.bank import Block, db_to_amp

CUT_S = 0.003
META = D.meta("riser", "Riser: noise band and sine sweeping up together while the level grows, cut at the end.", ["riser", "build up", "tension", "sweep", "transition"], "swept filtered noise and sine (sfxdsp.swept_band_tone)")


class Riser(Block):
    ID = "riser"
    # 12 October 2026 (A1): coupled parameters scanned jointly by dfit (see dfit scanPairs).
    FIT = {"scanPairs": [["onset_s", "duration_s"], ["start_hz", "curve"]]}
    PARAMS = [
        D.param("start_hz", "Hz", 60, 4000, 300, "log", "centre at the start"),
        D.param("end_hz", "Hz", 500, 16000, 6000, "log", "centre at the end"),
        D.param("bw_oct", "octaves", 0.3, 4.0, 1.2, "log", "noise band width"),
        D.param("duration_s", "s", 0.15, 0.85, 0.7, "log", "length of the rise"),
        D.param("curve", "power", 0.5, 5.0, 2.0, "log", "level growth exponent"),
        D.param("tone_db", "dB re noise", -40, 0, -10, "lin", "sine level"),
        D.AMP(-14.0), D.ONSET(0.12, 0.02),
    ]

    def synth(self, v, t, sr):
        o, d = v["onset_s"], v["duration_s"]
        x = D.progress(t, o, d)
        env = torch.pow(x + 1e-6, v["curve"]) * torch.sigmoid((o + d - t) / CUT_S)
        y = D.swept_band_tone(self.noise(t.shape[0], t.device), t, sr, o, d, v["start_hz"], v["end_hz"], v["bw_oct"], v["tone_db"])
        return db_to_amp(v["amp_db"]) * env * y


BLOCK = Riser
