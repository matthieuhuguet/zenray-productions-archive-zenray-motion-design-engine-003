# 12 October 2026: pulse_lead, a band-limited pulse (difference of two polyBLEP saws) with duty cycle, sine vibrato,
# static lowpass, attack and decay. FR : onde pulsée à rapport cyclique, vibrato, passe-bas.
import math

import torch

from zrmd.audio.bank import Block, db_to_amp, envelope, stft_filter
from zrmd.audio import fxdsp as F
from zrmd.audio.fxdsp import param as P

META = {"family": "subtractive", "kind": "source",
        "description": "polyBLEP pulse wave with duty cycle, sine vibrato and lowpass. Chiptune and retro leads, 8-bit UI tones. (12 October 2026)",
        "tags": ["tonal", "pulse", "square", "chiptune", "lead", "vibrato"],
        "sources": [{"what": "polyBLEP oscillator", "url": None, "reference": "Valimaki and Huovilainen 2007", "licence": F.SOURCE}, F.RBJ],
        "licence": "original"}


class PulseLead(Block):
    ID = "pulse_lead"
    # 12 October 2026 (A2): fit hints measured on the failed cases of the first A2 verification (docs/build/
    # A2-tonal-effects.md): a larger search budget (second pass: finer scans, which a pitch basin of
    # about 0.07 semitone at the third partial needs, and a larger evolution strategy), and coupled groups for the evolution strategy. FR : indications.
    FIT = {"scanRounds": 6, "polishRounds": 12, "starts": 24, "screenSamples": 4096, "esSamples": 80, "esIters": 20,
           "scanGroups": [["width", "cutoff_hz", "amp_db"], "*"]}
    PARAMS = [
        P("f0_hz", "Hz", 60, 2000, 330, "log", "pitch"),
        P("width", "duty", 0.05, 0.5, 0.3, "lin", "pulse duty cycle (0.5 square)"),
        P("cutoff_hz", "Hz", 200, 16000, 3000, "log", "lowpass cutoff"),
        P("vib_rate_hz", "Hz", 0.5, 9.0, 5.5, "lin", "vibrato rate"),
        P("vib_cents", "cents", 0.0, 80.0, 15.0, "lin", "vibrato depth"),
        P("attack_s", "s", 0.001, 0.3, 0.01, "log", "linear attack"),
        P("decay_s", "s (T60)", 0.1, 6.0, 1.0, "log", "time to fall 60 dB"),
        P("amp_db", "dBFS", -60, 0, -12, "lin", "peak level"),
        P("onset_s", "s", 0.0, 0.25, 0.02, "lin", "start time in the window"),
    ]

    def synth(self, v, t, sr):
        f = v["f0_hz"] * torch.pow(2.0, v["vib_cents"] / 1200.0 * torch.sin(F.TWO_PI * v["vib_rate_hz"] * t))
        y = F.pulse(f, sr, v["width"])
        y = stft_filter(y, lambda fr, tm: F.biquad_mag("lowpass", fr, v["cutoff_hz"], torch.tensor(0.707), sr=sr), 1024, 256, sr)
        return F.amp(v) * F.env_of(t, v) * y


BLOCK = PulseLead
