# 12 October 2026: stereo_pan, constant power panning L = cos(theta) x, R = sin(theta) x, theta = (pan + 1) pi / 4.
# Stereo block: fx_stereo returns [2, n]; in a mono chain and when rendered alone it gives its LEFT channel (so the
# mono loss still sees the pan), fxdsp.render_chain_stereo gives both. FR : panoramique à puissance constante.
import math

import torch

from zrmd.audio.bank import db_to_amp, stft_filter
from zrmd.audio import fxdsp as F
from zrmd.audio.fxdsp import EffectBlock
from zrmd.audio.fxdsp import param as P

META = {"family": "stereo", "kind": "effect", "stereo": True,
        "description": "Constant power pan. Stereo block: mono view is the left channel, render_chain_stereo renders both. Placement of a sound in the stereo field. (12 October 2026)",
        "tags": ["effect", "stereo", "pan", "placement"],
        "sources": [{"what": "constant power pan law", "url": None, "licence": F.SOURCE}],
        "licence": "original"}


class StereoPan(EffectBlock):
    ID = "stereo_pan"
    STEREO = True
    PARAMS = [
        P("pan", "-1..1", -1.0, 1.0, -0.5, "lin", "-1 left, 0 centre, 1 right"),
        P("out_db", "dB", -24, 12, 0, "lin", "output gain"),
    ]

    def fx_stereo(self, v, x, t, sr):
        th = (v["pan"] + 1.0) * math.pi / 4.0
        g = db_to_amp(v["out_db"])
        return torch.stack([g * torch.cos(th) * x, g * torch.sin(th) * x])


BLOCK = StereoPan
