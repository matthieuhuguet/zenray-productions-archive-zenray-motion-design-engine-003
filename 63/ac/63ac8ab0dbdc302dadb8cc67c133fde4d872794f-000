def union_seconds(ranges):
    iv = sorted(ranges)
    tot, cur = 0.0, None
    for a, b in iv:
        if cur is None or a > cur[1]:
            if cur:
                tot += cur[1] - cur[0]
            cur = [a, b]
        else:
            cur[1] = max(cur[1], b)
    if cur:
        tot += cur[1] - cur[0]
    return round(tot, 2)


def measure(small, bible):
    ts = np.arange(len(small)) / SMALL_FPS
    L = luma(small.reshape(len(small), -1, 3)).reshape(len(small), SMALL_H, SMALL_W)
    m = {}

    # 12 October 2026: void black and grain.
    f55, f95 = full_frame(5.5), full_frame(9.5)
    m["void-black-grain"] = {
        "black_corner_5.5": box_stats(f55, [0.0, 0.0, 0.25, 0.25]),
        "black_corner_9.5": box_stats(f95, [0.0, 0.0, 0.25, 0.25]),
        "grain_black": grain(f55, [0.0, 0.0, 0.25, 0.25]),
        "share_frames_mean_luma_below_8": round(float((L.mean((1, 2)) < 8).mean()), 3),
    }

    # 12 October 2026: orb radius, centre and colour field.
    orb = []
    for i in range(0, int(1.45 * SMALL_FPS)):
        mask = L[i] > 40
        a = mask.sum()
        if a < 4:
            continue
        ys, xs = np.nonzero(mask)
        orb.append({"t": round(float(ts[i]), 3), "radius_h": round(float(np.sqrt(a / np.pi) / SMALL_H), 4),
                    "cx_w": round(float(xs.mean() / SMALL_W), 4), "cy_h": round(float(ys.mean() / SMALL_H), 4)})
    f07, f11 = full_frame(0.7), full_frame(1.1)

    def orb_field(f):
        l = luma(f)
        mask = (l > 40).astype(np.uint8)
        ys, xs = np.nonzero(mask)
        cx, cy, r = xs.mean(), ys.mean(), np.sqrt(mask.sum() / np.pi)
        yy, xx = np.mgrid[0:f.shape[0], 0:f.shape[1]]
        rr = np.hypot(xx - cx, yy - cy) / r
        ang = np.degrees(np.arctan2(yy - cy, xx - cx))  # 0 = right, 90 = down
        rad = []
        for a0, a1 in [(0, 0.2), (0.2, 0.5), (0.5, 0.8), (0.8, 0.95), (0.95, 1.05), (1.05, 1.3)]:
            sel = (rr >= a0) & (rr < a1)
            rad.append({"r_from": a0, "r_to": a1, "median_rgb": rgb(np.median(f[sel], 0)), "hex": hexc(np.median(f[sel], 0))})
        rim = []
        for a_c in range(-180, 180, 45):
            sel = (rr > 0.9) & (rr < 1.0) & (np.abs(((ang - a_c + 180) % 360) - 180) < 22.5)
            rim.append({"angle_deg_0_right_90_down": a_c, "hex": hexc(np.median(f[sel], 0))})
        pools = []
        for name, (dx, dy) in {"upper": (0, -0.5), "lower": (0, 0.55), "left": (-0.55, 0), "right": (0.55, 0)}.items():
            sel = np.hypot(xx - (cx + dx * r), yy - (cy + dy * r)) < 0.12 * r
            pools.append({"at": name, "hex": hexc(np.median(f[sel], 0))})
        return {"centre_px": [round(float(cx), 1), round(float(cy), 1)], "radius_px": round(float(r), 1),
                "radial": rad, "rim_polar": rim, "interior_pools": pools}
    m["orb-radial-glow"] = {"track": orb[::3], "field_0.7": orb_field(f07), "field_1.1": orb_field(f11),
                            "halo_1.1": halo_profile(f11, [0.0, 0.0, 1.0, 1.0], core_luma=200)}

    # 12 October 2026: arch wallpaper, vertical profile through the apex (fullscreen moment) and in-screen moment.
    f15, f19, f23 = full_frame(1.5), full_frame(1.9), full_frame(2.3)

    def vprofile(f, x, y0, y1, n=20):
        col = f[:, int(x * f.shape[1]) - 3:int(x * f.shape[1]) + 3].astype(np.float32).mean(1)
        return [{"y": round(y, 3), "hex": hexc(col[min(f.shape[0] - 1, int(y * f.shape[0]))])}
                for y in np.linspace(y0, y1, n)]

    def hprofile(f, y, x0, x1, n=16):
        row = f[int(y * f.shape[0]) - 3:int(y * f.shape[0]) + 3].astype(np.float32).mean(0)
        return [{"x": round(x, 3), "hex": hexc(row[min(f.shape[1] - 1, int(x * f.shape[1]))])}
                for x in np.linspace(x0, x1, n)]
    m["arch-glow-wallpaper"] = {
        "vprofile_1.5_x0.5": vprofile(f15, 0.5, 0.0, 1.0),
