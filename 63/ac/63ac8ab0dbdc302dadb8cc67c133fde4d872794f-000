    for sid, t in [("S27", 58.7), ("S28", 60.0), ("S29", 61.3)]:
        f = full_frame(t)
        smoke[sid] = {"t": t, "letters_ramp": ramp_by_luma(f, [0.02, 0.15, 0.4, 0.8], pcts=(10, 30, 50, 70, 90, 98), min_luma=6),
