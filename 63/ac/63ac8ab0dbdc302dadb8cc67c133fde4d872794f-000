        "vprofile_1.9_x0.5_apex": vprofile(f19, 0.5, 0.3, 1.0),
        "vprofile_1.9_x0.33_side": vprofile(f19, 0.33, 0.3, 1.0),
        "hprofile_1.9_y0.85": hprofile(f19, 0.85, 0.25, 0.75),
        "vprofile_2.3_x0.5_in_screen": vprofile(f23, 0.5, 0.2, 0.95),
