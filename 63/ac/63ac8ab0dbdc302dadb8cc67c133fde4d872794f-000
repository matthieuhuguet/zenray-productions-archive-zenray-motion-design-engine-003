def luma(img):
    # 12 October 2026: Rec. 709 luma on 0..255 sRGB values (no linearisation, matches what the eye reads on a frame).
    img = img.astype(np.float32)
    return 0.2126 * img[..., 0] + 0.7152 * img[..., 1] + 0.0722 * img[..., 2]


def hexc(rgb):
    r, g, b = [int(round(float(x))) for x in rgb]
    return f"#{r:02x}{g:02x}{b:02x}"


def rgb(v):
    return [int(round(float(x))) for x in v]


def full_frame(t: float) -> np.ndarray:
    # 12 October 2026: one lossless PNG per analysis time, decoded once and cached locally.
    FRAMES.mkdir(parents=True, exist_ok=True)
    p = FRAMES / f"t{t:07.3f}.png"
    if not p.exists():
        subprocess.run(["ffmpeg", "-v", "error", "-ss", f"{t:.3f}", "-i", VIDEO, "-frames:v", "1", "-y", str(p)], check=True)
    return cv2.cvtColor(cv2.imread(str(p)), cv2.COLOR_BGR2RGB)


def small_stream() -> np.ndarray:
    # 12 October 2026: whole film at 480x270, 30 fps, for timing curves.
    raw = subprocess.run(["ffmpeg", "-v", "error", "-i", VIDEO, "-vf", f"scale={SMALL_W}:{SMALL_H},fps={SMALL_FPS}",
                          "-f", "rawvideo", "-pix_fmt", "rgb24", "-"], check=True, capture_output=True).stdout
    return np.frombuffer(raw, np.uint8).reshape(-1, SMALL_H, SMALL_W, 3)


def sub(img, box):
    # 12 October 2026: box = [x0, y0, x1, y1] as fractions of the frame.
    h, w = img.shape[:2]
    x0, y0, x1, y1 = box
    return img[int(y0 * h):max(int(y0 * h) + 1, int(y1 * h)), int(x0 * w):max(int(x0 * w) + 1, int(x1 * w))]


def box_stats(img, box):
    a = sub(img, box).reshape(-1, 3).astype(np.float32)
    l = luma(a)
    return {"box": box, "median_rgb": rgb(np.median(a, 0)), "hex": hexc(np.median(a, 0)), "mean_rgb": rgb(a.mean(0)),
            "luma_p5": round(float(np.percentile(l, 5)), 1), "luma_p95": round(float(np.percentile(l, 95)), 1)}


def ramp_by_luma(img, box, pcts=(5, 25, 50, 75, 95), min_luma=0.0):
    # 12 October 2026: colour of the pixels at given luma percentiles, i.e. the colour ramp a gradient block must reproduce.
    a = sub(img, box).reshape(-1, 3).astype(np.float32)
    l = luma(a)
    keep = l >= min_luma
    a, l = a[keep], l[keep]
    order = np.argsort(l)
    out = []
    for p in pcts:
        win = order[max(0, int(p / 100 * len(order)) - 200):int(p / 100 * len(order)) + 200]
        c = np.median(a[win], 0)
        out.append({"pct": p, "rgb": rgb(c), "hex": hexc(c), "luma": round(float(luma(c[None])[0]), 1)})
    return out


def halo_profile(img, box, core_luma=235, dists=(0, 2, 4, 8, 16, 32, 64)):
    # 12 October 2026: mean luma as a function of the distance (px at 1080p) from the saturated core = bloom falloff.
    a = sub(img, box)
    l = luma(a)
    core = (l >= core_luma).astype(np.uint8)
    if core.sum() < 5:
        return {"core_px": int(core.sum())}
    d = cv2.distanceTransform(1 - core, cv2.DIST_L2, 5)
    prof = []
    for i, dd in enumerate(dists):
        hi = dists[i + 1] if i + 1 < len(dists) else dd * 2
        m = (d > dd) & (d <= hi) if dd > 0 else core.astype(bool)
        if m.sum():
            prof.append({"from_px": dd, "to_px": hi, "mean_luma": round(float(l[m].mean()), 1),
                         "mean_rgb": rgb(a[m].mean(0))})
    return {"core_px": int(core.sum()), "core_luma_threshold": core_luma, "profile": prof}


def sharpness_grid(img, n=3):
    # 12 October 2026: variance of the Laplacian per cell, normalised to the sharpest cell: a depth of field map.
    g = cv2.cvtColor(img, cv2.COLOR_RGB2GRAY)
    h, w = g.shape
    out = []
    for r in range(n):
        row = []
        for c in range(n):
            cell = g[r * h // n:(r + 1) * h // n, c * w // n:(c + 1) * w // n]
            row.append(float(cv2.Laplacian(cell, cv2.CV_64F).var()))
        out.append(row)
    mx = max(max(r) for r in out) or 1.0
    return [[round(v / mx, 3) for v in r] for r in out]


def grain(img, box, sigma=2.0):
    # 12 October 2026: grain = std of the high-pass luma (image minus a Gaussian blur) in a flat region.
    l = luma(sub(img, box))
    hp = l - cv2.GaussianBlur(l, (0, 0), sigma)
    return {"box": box, "highpass_std": round(float(hp.std()), 3), "mean_luma": round(float(l.mean()), 2)}


def ramp_times(t, y, lo=0.1, hi=0.9):
    # 12 October 2026: rise and fall times (10 to 90 percent of the peak) of a curve.
    y = np.asarray(y, np.float64)
    if y.max() <= 0:
        return {}
    pk = y.max()
    above_lo = np.where(y >= lo * pk)[0]
    above_hi = np.where(y >= hi * pk)[0]
    r = {"peak": round(float(pk), 2), "t_peak": round(float(t[int(np.argmax(y))]), 3)}
    if len(above_lo) and len(above_hi):
        r["rise_start"] = round(float(t[above_lo[0]]), 3)
        r["rise_end"] = round(float(t[above_hi[0]]), 3)
        r["fall_start"] = round(float(t[above_hi[-1]]), 3)
        r["fall_end"] = round(float(t[above_lo[-1]]), 3)
    return r


def save_crop(name, t, box):
    CROPS.mkdir(parents=True, exist_ok=True)
    img = sub(full_frame(t), box)
    p = CROPS / f"{name}.png"
    cv2.imwrite(str(p), cv2.cvtColor(img, cv2.COLOR_RGB2BGR))
    return {"file": str(p), "t": t, "box": box, "size": [img.shape[1], img.shape[0]]}


