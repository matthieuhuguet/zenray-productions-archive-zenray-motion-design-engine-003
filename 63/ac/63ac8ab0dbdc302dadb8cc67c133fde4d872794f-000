        floor[sid] = {"t": t, "floor": box_stats(f, [0.0, 0.85, 1.0, 1.0]), "reflection_ratio_floor_over_letters": round(float(lower / max(upper, 1e-3)), 3),
                      "vertical_sharpness_ratio": round(float(cv2.Laplacian(cv2.cvtColor(sub(f, [0.0, 0.85, 1.0, 1.0]), cv2.COLOR_RGB2GRAY), cv2.CV_64F).var()
                                                              / max(1e-3, cv2.Laplacian(cv2.cvtColor(sub(f, [0.0, 0.2, 1.0, 0.6]), cv2.COLOR_RGB2GRAY), cv2.CV_64F).var())), 3)}
    m["smoke-letters-volumetric"] = smoke
    m["reflective-floor-fog"] = floor
    f587 = full_frame(58.7)
    m["dark-device-fresnel-rim"] = {"body_58.7": box_stats(f587, [0.47, 0.4, 0.55, 0.7]),
                                    "rim_ramp_58.7": ramp_by_luma(f587, [0.38, 0.2, 0.62, 0.95], pcts=(50, 90, 98, 99.5), min_luma=0),
                                    "edge_21.0": ramp_by_luma(f210, [0.42, 0.0, 0.55, 1.0], pcts=(50, 90, 98, 99.5), min_luma=0)}
    m["bloom-halo"] = {"orb_rim_1.1": m["orb-radial-glow"]["halo_1.1"], "chip_16.4": m["chip-emissive-iridescent"]["chip_halo_16.4"],
                       "ring_50.4": m["neon-ring-glow"]["halo_50.4"], "beam_17.0": m["green-light-beams"]["beam_halo_17.0"]}

    # 12 October 2026: end mark colour over time (colour of light pixels in the centre).
    i0, i1 = int(62.0 * SMALL_FPS), min(len(small), int(68.0 * SMALL_FPS))
    lc = []
    for i in range(i0, i1, 3):
        reg = small[i, int(0.3 * SMALL_H):int(0.7 * SMALL_H), int(0.4 * SMALL_W):int(0.6 * SMALL_W)].reshape(-1, 3).astype(np.float32)
        ll = luma(reg)
        sel = ll > 25
        lc.append({"t": round(float(ts[i]), 2), "px": int(sel.sum()),
                   "hex": hexc(np.median(reg[sel], 0)) if sel.sum() > 3 else None,
                   "luma_p95": round(float(np.percentile(ll, 99)), 1)})
    m["logo-colour-fade"] = {"curve_every_0.1s": lc, "timing": ramp_times(np.array([x["t"] for x in lc]), [x["px"] for x in lc])}

    # 12 October 2026: fades around each cut: mean luma just before and after, and dip depth.
    ml = L.mean((1, 2))
    dips = []
    for c in bible["cuts"]:
        k = int(round(c["t"] * SMALL_FPS))
        before = ml[max(0, k - 18):k]
        after = ml[k:k + 18]
        if not len(before) or not len(after):
            continue
        prev = ml[max(0, k - 45):max(1, k - 18)].mean()
        nxt = ml[k + 18:k + 45].mean() if k + 45 < len(ml) else after.mean()
        dips.append({"t": round(c["t"], 3), "kind": c["kind"], "mean_luma_prev": round(float(prev), 1),
                     "min_last_0.6s": round(float(before.min()), 1), "min_first_0.6s": round(float(after.min()), 1),
                     "mean_luma_next": round(float(nxt), 1),
                     "dip_to_black": bool(min(before.min(), after.min()) < 3 and max(prev, nxt) > 6)})
    m["dip-to-black-transitions"] = {"cuts": dips, "count_dips": int(sum(d["dip_to_black"] for d in dips))}
    return m


def main():
    bible = json.loads(BIBLE.read_text())
    times = sorted({c[0] for lk in LOOKS for c in lk["crops"]} | {0.7, 1.1, 1.5, 1.9, 2.3, 3.2, 4.4, 5.5, 6.8, 8.0, 9.5, 10.9, 12.4, 13.6, 14.2,
                                                                  15.2, 16.4, 17.0, 18.6, 21.0, 22.9, 27.5, 30.6, 33.0, 35.5, 38.0, 42.0, 47.0,
                                                                  50.4, 50.9, 53.0, 58.7, 60.0, 61.3, 63.3, 64.0})
    with ThreadPoolExecutor(WORKERS) as ex:
        list(ex.map(full_frame, times))
    small = small_stream()
    meas = measure(small, bible)
    total = bible["source"]["duration_s"]
    out = []
    for lk in LOOKS:
        crops = [save_crop(f"{lk['id']}-{i + 1}", t, b) for i, (t, b) in enumerate(lk["crops"])]
        secs = union_seconds(lk["ranges"]) if lk["ranges"] else None
        out.append({"id": lk["id"], "name": lk["name"], "shots": lk["shots"], "time_ranges_s": lk["ranges"],
                    "screen_time_s": secs, "screen_share": round(secs / total, 3) if secs else None,
                    "summary": SUMMARY.get(lk["id"], ""), "block_families": lk["families"], "measured": meas.get(lk["id"], {}), "crops": crops})
    out.sort(key=lambda x: -(x["screen_time_s"] or 0))
    for i, x in enumerate(out):
        x["priority"] = i + 1
    doc = {"schema": "zrmd/looks@1", "date": "12 October 2026", "slug": "onekey-pro-2",
           "source": {"video": Path(VIDEO).name, "duration_s": total, "width": FULL_W, "height": FULL_H, "fps": bible["source"]["fps"]},
           "method": "Measured by Scripts/MeasureLooksOnekey.py on the local reference cache: colours are medians of sRGB pixels, "
                     "sizes are fractions of the frame (or px at 1080p where stated), timings from a 30 fps 480x270 decode. "
                     "Crops are analysis-only, local, never archived, never a texture. (12 October 2026)",
           "looks": out}
    OUT_JSON.write_text(json.dumps(doc, indent=1, ensure_ascii=False))
    print(OUT_JSON, len(out))


if __name__ == "__main__":
    main()
