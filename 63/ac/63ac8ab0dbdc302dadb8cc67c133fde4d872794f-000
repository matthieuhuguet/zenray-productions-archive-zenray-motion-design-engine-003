def title_colour(f):
    # 12 October 2026: median colour of the low-saturation light pixels of the title band (glyphs only).
    band = sub(f, [0.6, 0.4, 0.95, 0.63]).reshape(-1, 3).astype(np.float32)
    mx, mn = band.max(-1), band.min(-1)
    sel = ((mx - mn) / np.maximum(mx, 1) < 0.12) & (mx > 25)
    return {"glyph_px": int(sel.sum()), "hex": hexc(np.median(band[sel], 0)) if sel.sum() else None}


