# 12 October 2026: cloth_swish, band-limited noise (low-pass at cut_hz, high-pass four octaves below) under a bell
# envelope, with a flutter amplitude modulation: clothes, sleeves, fabric moves. Derived from the mathematics.
# FR : frottement de tissu.
import math

import torch

from zrmd.audio import sfxdsp as D
from zrmd.audio.bank import Block, db_to_amp

HP_BELOW_OCT = 4.0
META = D.meta("foley", "Cloth swish: low-passed noise under a bell envelope with a flutter amplitude modulation.", ["foley", "cloth", "fabric", "swish", "movement", "noise"], "filtered noise, bell envelope, sine amplitude modulation")


class ClothSwish(Block):
    ID = "cloth_swish"
    PARAMS = [
        D.param("cut_hz", "Hz", 300, 8000, 2000, "log", "low-pass cutoff"),
        D.param("duration_s", "s", 0.1, 0.85, 0.4, "log", "total length"),
        D.param("peak_pos", "x duration", 0.15, 0.85, 0.4, "lin", "position of the loudest instant"),
        D.param("flutter_hz", "Hz", 2, 40, 10, "log", "flutter rate"),
        D.param("flutter_depth", "0..1", 0.0, 1.0, 0.3, "lin", "flutter depth"),
        D.AMP(-14.0), D.ONSET(0.12, 0.02),
    ]

    def synth(self, v, t, sr):
        o = v["onset_s"]
        am = 1.0 - v["flutter_depth"] * 0.5 * (1.0 - torch.cos(2.0 * math.pi * v["flutter_hz"] * torch.clamp(t - o, min=0.0)))
        n = D.filtered(self.noise(t.shape[0], t.device), lambda fr: D.lowpass(fr, v["cut_hz"], 12.0) * D.highpass(fr, v["cut_hz"] / 2.0 ** HP_BELOW_OCT, 12.0), sr)
        return db_to_amp(v["amp_db"]) * D.bell(t, o, v["duration_s"], v["peak_pos"], 2.0) * am * n


BLOCK = ClothSwish
