# 12 October 2026: F3 codec ceiling. How high can a mask IoU go against a video frame when the outlines are
# EXACTLY right? A known text (font, size, colour, position of a fitted mark version) is rendered, encoded with the
# reference's codec settings (H.264, 1920x1080, 60 fps, the reference bitrate), decoded, read back through the same
# coverage pipeline as a reference crop, and compared with the exact coverage. The result is the ceiling a 1:1
# reproduction can reach against this reference, and the fitter is then run on the decoded frame (known truth).
import argparse
import json
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import numpy as np  # noqa: E402
from PIL import Image  # noqa: E402

from zrmd import settings  # noqa: E402
from zrmd.vector import marks as K  # noqa: E402


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--slug", default="onekey-pro-2")
    ap.add_argument("--mark", required=True)
    ap.add_argument("--version", required=True)
    ap.add_argument("--bitrate", default=None, help="default: the reference video bitrate (ffprobe)")
    ap.add_argument("--fit", action="store_true", help="also run the marks fitter on the decoded frame")
    ap.add_argument("--wrong-font", default=None, help="red case: fit with this font file instead")
    ap.add_argument("--out", required=True)
    a = ap.parse_args()
    md = K.motion_dir(a.slug, a.mark)
    P = json.loads((md / a.version / "params.json").read_text())
    rgba = K.cook_text(P)
    truth = rgba[..., 3].astype(np.float32) / 255.0
    frame = (rgba[..., :3].astype(np.float32) * truth[..., None]).round().astype(np.uint8)
    video = K.reference_video(a.slug)
    br = a.bitrate or subprocess.run(["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries",
                                      "stream=bit_rate", "-of", "csv=p=0", str(video)], capture_output=True,
                                     text=True).stdout.strip()
    with tempfile.TemporaryDirectory() as tmp:
        Image.fromarray(frame).save(f"{tmp}/f.png")
        subprocess.run(["ffmpeg", "-loglevel", "error", "-y", "-loop", "1", "-i", f"{tmp}/f.png", "-t", "2", "-r", "60",
                        "-c:v", "libx264", "-pix_fmt", "yuv420p", "-b:v", str(br), "-profile:v", "high",
                        f"{tmp}/c.mp4"], check=True)
        subprocess.run(["ffmpeg", "-loglevel", "error", "-y", "-ss", "1.0", "-i", f"{tmp}/c.mp4", "-frames:v", "1",
                        f"{tmp}/d.png"], check=True)
        dec = np.asarray(Image.open(f"{tmp}/d.png").convert("RGB")).astype(np.float32)
    # read the decoded frame exactly like a reference crop (same region and pipeline)
    x, y, w, h = P["source"]["region"]
    crop = dec[y:y + h, x:x + w]
    d = K.mark_cache(a.slug, "_ceiling-" + a.mark)
    Image.fromarray(crop.astype(np.uint8)).save(d / "crop.png")
    (d / "frame.json").write_text(json.dumps({"time_s": 0.0, "synthetic": True}))
    mark = {"id": "_ceiling-" + a.mark, "region": P["source"]["region"]}
    ref = K.reference_of(a.slug, mark)
    ox, oy = ref["offset"]
    hh, ww = ref["c"].shape
    t = truth[oy:oy + hh, ox:ox + ww]
    f = K.fidelity(ref["c"], t, np.ones_like(t), ref["rgb"], ref["rgb"])
    out = {"date": "12 October 2026", "mark": a.mark, "version": a.version, "bitrate": br,
           "ceiling_exact_outlines": {k: f[k] for k in ("iou_soft", "iou_hard", "edge_mean_px")}}
    print(json.dumps(out), flush=True)
    if a.fit or a.wrong_font:
        font = a.wrong_font or P["font"]["file"]
        keep = np.asarray(K.ndi.binary_dilation(ref["keep"], iterations=2), np.float32)
        p = K.fit_text(P["text"], font, ref["c"], ref["weight"], init_mask=keep)
        fit_c = K.render_line(p, (ww, hh))
        g = K.fidelity(ref["c"], fit_c, np.ones_like(t), ref["rgb"], ref["rgb"])
        out["fit_on_decoded"] = {"font": Path(font).parent.name, **{k: g[k] for k in ("iou_soft", "iou_hard", "edge_mean_px")},
                                 "size_true": P["size_px"], "size_fit": round(p["size"], 3), "axes": p["axes"]}
        print(json.dumps(out["fit_on_decoded"]), flush=True)
    Path(a.out).write_text(json.dumps(out, indent=1))


if __name__ == "__main__":
    main()
