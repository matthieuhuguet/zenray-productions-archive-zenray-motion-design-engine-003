# 12 October 2026, 14:00 CEST: generator of the shader bank block arch_ramp_grid (GLSL + numpy twin + block.json).
# The look: a power-curve arch va(x) = apex + k |x|^p; every pixel gets the normal distance t outside the arch (canvas
# heights, negative inside) and its height v; its colour is a smooth 2D colour grid over (t, v): ND knots between t0 and
# t1, NV knots between 0 and 1, bilinear with smoothstep weights. The grid colours are plain colour parameters, editable
# one by one, and linear in the image, so a fit solves them exactly by least squares. ND and NV are the only constants.
import json
from pathlib import Path

ND, NV = 8, 4
BANK = Path(__file__).resolve().parents[1] / "datasets" / "shaders" / "arch_ramp_grid"
BANK.mkdir(parents=True, exist_ok=True)
names = [f"c_{i}_{j}" for j in range(NV) for i in range(ND)]  # v-major: index j * ND + i
geo = [("cx", "float", 0.5, 0.3, 0.7), ("apex", "float", 0.6, 0.2, 0.9), ("k", "float", 0.6, 0.05, 1.5), ("p", "float", 2.0, 0.8, 3.5),
       ("t0", "float", -0.02, -0.2, 0.0), ("t1", "float", 0.6, 0.1, 1.5), ("aspect", "float", 0.63, 0.3, 2.5)]
params = [{"name": n, "type": t, "default": d, "min": lo, "max": hi, "unit": "canvas"} for n, t, d, lo, hi in geo]
params += [{"name": n, "type": "color", "default": [0.5, 0.5, 0.5], "min": [0, 0, 0], "max": [1, 1, 1], "unit": "srgb"} for n in names]
meta = {"id": "arch_ramp_grid", "family": "A", "description": f"Power-curve arch with a {ND} x {NV} colour grid over (normal distance outside the arch, height), smoothstep bilinear; colours are linear in the image, so they are solved exactly by least squares. Colour block. (12 October 2026)",
        "params": params, "source_url": "original", "licence": "original (written from the mathematics), same licence as the engine",
        "attribution": "ZenRay Motion Design", "tags": ["arch", "gradient", "wallpaper", "fit"], "looks": ["arch-glow-wallpaper"]}
(BANK / "block.json").write_text(json.dumps(meta, indent=1) + "\n")
args = ", ".join([f"float {n}" for n, *_ in geo] + [f"vec3 {n}" for n in names])
glsl = f"""// 12 October 2026: arch_ramp_grid, generated by Scripts/MakeArchRampGrid.py (do not edit by hand). Licence: original.
vec4 arch_ramp_grid(vec2 uv, {args}) {{
  vec3 C[{ND * NV}] = vec3[]({", ".join(names)});
  float x = abs(2.0 * (uv.x - cx));
  float slope = 2.0 * k * p * pow(max(x, 1e-4), p - 1.0) / aspect;
  float t = -(uv.y - (apex + k * pow(x, p))) * inversesqrt(1.0 + slope * slope);
  float fi = clamp((t - t0) / (t1 - t0), 0.0, 1.0) * {ND - 1}.0;
  float fj = clamp(uv.y, 0.0, 1.0) * {NV - 1}.0;
  int i0 = min(int(floor(fi)), {ND - 2}); int j0 = min(int(floor(fj)), {NV - 2});
  float a = smoothstep(0.0, 1.0, fi - float(i0)); float b = smoothstep(0.0, 1.0, fj - float(j0));
  vec3 c0 = mix(C[j0 * {ND} + i0], C[j0 * {ND} + i0 + 1], a);
  vec3 c1 = mix(C[(j0 + 1) * {ND} + i0], C[(j0 + 1) * {ND} + i0 + 1], a);
  return vec4(mix(c0, c1, b), 1.0);
}}
"""
(BANK / "block.glsl").write_text(glsl)
twin = f'''# 12 October 2026: numpy twin of arch_ramp_grid, generated by Scripts/MakeArchRampGrid.py (do not edit by hand).
import numpy as np

ND, NV = {ND}, {NV}
NAMES = {names!r}


def _ss(x):
    x = np.clip(x, 0.0, 1.0)
    return x * x * (3.0 - 2.0 * x)


def coords(q, u, v):
    x = np.abs(2.0 * (u - q["cx"]))
    slope = 2.0 * q["k"] * q["p"] * np.maximum(x, 1e-4) ** (q["p"] - 1.0) / q["aspect"]
    t = -(v - (q["apex"] + q["k"] * x ** q["p"])) / np.sqrt(1.0 + slope * slope)
    fi = np.clip((t - q["t0"]) / (q["t1"] - q["t0"]), 0.0, 1.0) * (ND - 1)
    fj = np.clip(v, 0.0, 1.0) * (NV - 1)
    return fi, fj


def basis(q, u, v):
    """Weights of the ND*NV grid colours per pixel, shape (..., ND*NV); the image is basis @ colours."""
    fi, fj = coords(q, u, v)
    i0 = np.minimum(np.floor(fi).astype(int), ND - 2); j0 = np.minimum(np.floor(fj).astype(int), NV - 2)
    a = _ss(fi - i0); b = _ss(fj - j0)
    W = np.zeros(fi.shape + (ND * NV,))
    for di, wa in ((0, 1 - a), (1, a)):
        for dj, wb in ((0, 1 - b), (1, b)):
            idx = (j0 + dj) * ND + (i0 + di)
            np.put_along_axis(W, idx[..., None], np.take_along_axis(W, idx[..., None], -1) + (wa * wb)[..., None], -1)
    return W


def render(params, u, v):
    C = np.array([params[n] for n in NAMES], float)
    return basis(params, u, v) @ C * 255.0
'''
(BANK / "twin.py").write_text(twin)
print(BANK)
